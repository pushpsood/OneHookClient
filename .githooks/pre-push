#!/bin/sh
# OneHookClient pre-push: TELEMETRY CONTRACT (HARD RULE) — see TELEMETRY_CONTRACT.txt.
# Every user interaction must report ui_interaction with a backend-controlled UiElement id. A push
# that breaks this is REJECTED here, before it leaves the machine (CI / the pipeline check again).
# Runs the same gate as `npm run build` (prebuild): catalog integrity + coverage/guard/SDK tests.
# Installed automatically by `npm install` / `npm run build` (git config core.hooksPath .githooks).
set -u
ROOT=$(git rev-parse --show-toplevel)
RED=$(printf '\033[1;31m'); GREEN=$(printf '\033[1;32m'); RESET=$(printf '\033[0m')

# Only pushes that touch the app (not deletes) need the check.
need=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
  need=1
done
[ "$need" = 0 ] && exit 0

if [ -n "$(git -C "$ROOT" status --porcelain -- src scripts TELEMETRY_CONTRACT.txt)" ]; then
  echo "[pre-push] note: uncommitted changes under src/; the telemetry check runs on the working tree."
fi
if ! (cd "$ROOT" && node scripts/telemetry-contract.mjs); then
  cat <<MSG
${RED}
################################################################################
#  PUSH REJECTED: TELEMETRY CONTRACT VIOLATION (HARD RULE)                     #
#  Every user interaction must report ui_interaction with a backend-controlled #
#  UiElement id. Fix the errors above (trackProps/trackUi with UiElement.X, or #
#  a valid data-track-exempt="<category>: <reason>"), then push again.         #
#  New id needed? Add it in OneHookBackend/packages/telemetry/src/catalog.ts.  #
################################################################################
${RESET}
MSG
  exit 1
fi
echo "${GREEN}[pre-push] telemetry contract: OK${RESET}"
