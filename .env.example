# OneHook Client environment template.
# Keep real secrets in `.env` or local overrides, not in git.

# App runtime
VITE_APP_ENV=development
VITE_API_BASE_URL=
VITE_WS_URL=
# AppSync GraphQL endpoint for chat messaging (from OneHookBackend chat stack output)
VITE_GRAPHQL_URL=
VITE_API_TIMEOUT_MS=30000

# Feature flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
VITE_USE_MOCK_API=true
VITE_LOG_LEVEL=debug

# Cognito (values provided by OneHookBackend deployment outputs)
VITE_COGNITO_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
# Identity Pool — provides temporary AWS creds for Rekognition Face Liveness streaming
VITE_COGNITO_IDENTITY_POOL_ID=
VITE_COGNITO_ENDPOINT=

# CDK deployment
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-east-1
