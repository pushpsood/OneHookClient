# OneHook Client local environment template.
# Deployment values are public and source-controlled in src/config/deployment.config.ts.
# Copy this file to ignored `.env` only when you need local overrides; never put secrets in VITE_*.

# Both deployed site artifacts intentionally select Gamma until the production backend is promoted.
VITE_APP_ENV=development
VITE_BACKEND_STAGE=gamma

# Optional local endpoint overrides (the defaults below are already checked in).
# VITE_API_BASE_URL=https://api.gamma.onehook.club
# VITE_GRAPHQL_URL=https://graphql.api.gamma.onehook.club/graphql
# VITE_CHATBOT_URL=https://onehook-chatbot-api.azurewebsites.net
# VITE_API_TIMEOUT_MS=30000

# Optional local feature overrides.
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG=false
# VITE_LOG_LEVEL=error

# Optional local Cognito overrides. These identifiers are public, not credentials.
# VITE_COGNITO_REGION=ap-south-1
# VITE_COGNITO_USER_POOL_ID=ap-south-1_pN10ldNoo
# VITE_COGNITO_CLIENT_ID=2rt0v69jq2acjaboom84cinign
# VITE_COGNITO_IDENTITY_POOL_ID=ap-south-1:8bfabd43-a446-4b8d-9201-b250cf3b62ef
# Derived automatically from the region unless overridden:
# VITE_COGNITO_ENDPOINT=https://cognito-idp.ap-south-1.amazonaws.com
# Hosted UI OAuth remains disabled until all three values are configured:
# VITE_COGNITO_DOMAIN=
# VITE_COGNITO_REDIRECT_SIGN_IN=http://localhost:3000
# VITE_COGNITO_REDIRECT_SIGN_OUT=http://localhost:3000

# CDK deployment (used only by local infrastructure commands).
CDK_DEFAULT_ACCOUNT=851725215059
CDK_DEFAULT_REGION=ap-south-1
