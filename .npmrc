# GitHub Packages registry for @pushpsood scope
@pushpsood:registry=https://npm.pkg.github.com

# Authentication token - only needed for publishing, not for installing public packages
# For publishing: set GITHUB_TOKEN in GitHub Actions (automatically provided)
# For local dev: public packages can be installed without authentication
# Uncomment the line below only if you need to install private packages:
# //npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
