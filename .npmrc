# The generated SDK (onehook-api-client) is a file: dependency pointing at the backend's
# Smithy-generated output. Install it as a real, hoisted copy rather than a symlink: a symlink
# keeps the SDK's runtime deps (@smithy/*, @aws-sdk/*) in a nested node_modules, which Vite's dev
# pre-bundler cannot reliably resolve — breaking the client at runtime. With install-links the SDK's
# deps hoist to the top level and are shared, matching how a published package would install.
install-links=true
