{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "dist-infra",
    "rootDir": "."
  },
  "ts-node": {
    "esm": true,
    "experimentalEsm": true
  },
  "include": ["infra/**/*"],
  "exclude": ["node_modules", "dist", "src"]
}
